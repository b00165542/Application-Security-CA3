# Copy this file to .env and replace every placeholder value before starting the app:
#   Copy-Item .env.example .env     (PowerShell)
#   cp .env.example .env            (Bash)
# .env is git-ignored. Never commit real credentials.
# Load it with:  uvicorn main:app --reload --env-file .env

# Signs the session cookie. Use a long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=SECRET_KEY

# Optional. Defaults to sqlite:///./coffee_shop.db
# DATABASE_URL=sqlite:///./coffee_shop.db

# First admin account. Only needed until an admin exists.
# Username: 3-32 chars (letters, digits, _ . -). Password: 8-72 chars.
ADMIN_USERNAME=ADMIN_USERNAME
ADMIN_PASSWORD=ADMIN_PASSWORD

# Demo products and accounts. Set to false to skip them; the DEMO_* values are then ignored.
SEED_DEMO_DATA=true

# Demo accounts. Required on every start while SEED_DEMO_DATA=true. Usernames must be unique.
DEMO_STAFF_USERNAME=DEMO_STAFF_USERNAME
DEMO_STAFF_PASSWORD=DEMO_STAFF_PASSWORD
DEMO_LOYALTY_USERNAME=DEMO_LOYALTY_USERNAME
DEMO_LOYALTY_PASSWORD=DEMO_LOYALTY_PASSWORD
